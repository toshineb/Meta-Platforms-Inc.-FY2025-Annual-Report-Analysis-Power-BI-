{
  "name": "Meta FY2025 Executive",
  "dataColors": ["#0866FF", "#1C2B33", "#7B61FF", "#00A7B5", "#F7B928", "#E41E3F", "#8A96A3", "#5AA7FF"],
  "background": "#FFFFFF",
  "foreground": "#1C2B33",
  "tableAccent": "#0866FF",
  "good": "#31A24C",
  "neutral": "#8A96A3",
  "bad": "#E41E3F",
  "maximum": "#0866FF",
  "center": "#BCD6FF",
  "minimum": "#EEF4FF",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1C2B33" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1C2B33" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 9, "color": "#65676B" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1C2B33" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F0F2F5" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E6EB" } }, "radius": 10 }],
        "title": [{ "show": true, "fontFamily": "Segoe UI Semibold", "fontSize": 12, "fontColor": { "solid": { "color": "#1C2B33" } }, "alignment": "left" }],
        "visualHeader": [{ "show": true, "transparency": 0 }],
        "padding": [{ "top": 12, "bottom": 10, "left": 14, "right": 14 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontFamily": "Segoe UI Semibold", "fontSize": 26, "color": { "solid": { "color": "#1C2B33" } } }],
        "categoryLabels": [{ "show": true, "fontFamily": "Segoe UI", "fontSize": 10, "color": { "solid": { "color": "#65676B" } } }]
      }
    },
    "slicer": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E6EB" } }, "radius": 8 }]
      }
    }
  }
}
